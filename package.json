{
  "name": "enise-docs",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Bibliothèque documentaire Centrale Lyon ENISE, déployable sur Cloudflare Workers.",
  "scripts": {
    "dev": "vite",
    "predev:worker": "node scripts/check-dev-vars.mjs",
    "dev:worker": "npm run build && wrangler dev --local --ip 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "lint": "eslint .",
    "test": "node --test tests/*.test.js",
    "count:files": "node scripts/count-bucket-files.mjs",
    "check": "npm run lint && npm run test && npm run build",
    "cf:typegen": "wrangler types",
    "deploy:space": "node scripts/deploy-space.js"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^16.5.0",
    "vite": "^8.2.2",
    "wrangler": "^4.125.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
