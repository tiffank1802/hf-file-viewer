# Token public Cloudflare Web Analytics (beacon navigateur).
# Sans cette variable, ou hors production, le script n’est pas chargé.
# Ne jamais y mettre CLOUDFLARE_API_TOKEN ni un secret d’administration.
VITE_CF_WEB_ANALYTICS_TOKEN=""

# --- Appwrite (projet « Django objects ») --------------------------------
# Les valeurs ci-dessous sont déjà codées en dur dans src/config.js : ces
# variables ne servent qu’à pointer un autre projet (préproduction, instance
# self-hosted). Une clé API Appwrite ne doit JAMAIS porter le préfixe VITE_.
# VITE_APPWRITE_ENDPOINT="https://fra.cloud.appwrite.io/v1"
# VITE_APPWRITE_PROJECT_ID="69cedb12002acdd498e0"
#
# Créés par la phase 1 du plan (docs/APPWRITE_AUTH_PLAN.md) :
# VITE_APPWRITE_DATABASE_ID="enise_docs"
# VITE_APPWRITE_PROFILE_TABLE_ID="profiles"
# VITE_APPWRITE_FAVORITES_TABLE_ID="favorites"
# VITE_APPWRITE_OAUTH_PROVIDER="github"
