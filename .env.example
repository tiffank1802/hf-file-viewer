# Token public Cloudflare Web Analytics (beacon navigateur).
# Sans cette variable, ou hors production, le script n’est pas chargé.
# Ne jamais y mettre CLOUDFLARE_API_TOKEN ni un secret d’administration.
VITE_CF_WEB_ANALYTICS_TOKEN=""

# Compte étudiant. Le navigateur parle à /api/auth, jamais à Appwrite.
# Les défauts Go pointent déjà vers le projet public. Ne pas mettre de clé
# API dans une variable VITE_. APPWRITE_DATABASE_ID reste vide tant que la
# table profiles n'existe pas : la connexion fonctionne quand même.
# APPWRITE_PUBLIC_ORIGIN force le domaine des emails (https://le-site).
# APPWRITE_ENABLED=0
# APPWRITE_DATABASE_ID=
# APPWRITE_PUBLIC_ORIGIN=
