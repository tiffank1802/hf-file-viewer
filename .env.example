# Token public Cloudflare Web Analytics (beacon navigateur).
# Sans cette variable, ou hors production, le script n’est pas chargé.
# Ne jamais y mettre CLOUDFLARE_API_TOKEN ni un secret d’administration.
VITE_CF_WEB_ANALYTICS_TOKEN=""

# Compte étudiant. Le navigateur parle à /api/auth et /api/favorites, jamais à Appwrite.
# Projet déjà connu du code : https://fra.cloud.appwrite.io/v1 , id 69cedb12002acdd498e0.
# La clé ne sert qu'au script de création des tables. Ne jamais la préfixer par VITE_.
# APPWRITE_API_KEY=""
# APPWRITE_DATABASE_ID="enise_docs"
# APPWRITE_PROFILE_TABLE_ID="profiles"
# APPWRITE_FAVORITES_TABLE_ID="favorites"
# APPWRITE_CONVERSATIONS_TABLE_ID="conversations"
# APPWRITE_MESSAGES_TABLE_ID="messages"
# APPWRITE_PUBLIC_ORIGIN force le domaine des emails (https://le-site).
# APPWRITE_ENABLED=0
